# Server-only runtime values. Configure secrets in Sites; never commit real keys.
AI_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Optional alternate provider:
# GEMINI_MODEL=
# GEMINI_API_KEY=

# Generated operational secrets, set only in Sites (at least 32 random characters):
USAGE_HASH_KEY=
OPS_TOKEN=
AI_ENABLED=true
AI_DAILY_REQUEST_LIMIT=200
# Conservative reservation units: serialized input bytes + 4096 per call.
# This bounds token exposure; it is not a dollar billing limit.
AI_DAILY_TOKEN_BUDGET=1000000
USER_DAILY_MESSAGE_LIMIT=80
USER_MINUTE_MESSAGE_LIMIT=6
APP_DAILY_MESSAGE_LIMIT=1000
APP_MINUTE_MESSAGE_LIMIT=60
